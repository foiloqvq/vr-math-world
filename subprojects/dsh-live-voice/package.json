{
  "name": "dsh-live-voice",
  "version": "0.1.0",
  "private": true,
  "description": "语音通话模式：一直听着 → 说完自动提交 → 回复读完继续听（本地 STT + 本机八千代 TTS）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/client.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
